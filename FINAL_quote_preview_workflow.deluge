// ============================================================
// Workflow: Auto-Generate Quote Preview
// Module: Quotes
// Trigger: On Create/Edit of Quote record
// 
// Purpose: Generates an editable quotation preview combining:
//   - Deal information (Deal_Name, Origin/Destination)
//   - Move_Types content (Quote_Main_Body, Quote_Bottom_Body)
// ============================================================

// Get the Quote record ID
quoteId = quote.get("id");

// Get the related Deal ID from the Quote
dealId = quote.get("Deal_Name").get("id");

if(dealId != null)
{
    // Fetch Deal details
    dealInfo = zoho.crm.getRecordById("Deals", dealId);
    
    if(dealInfo != null)
    {
        // Extract Deal fields
        dealName = dealInfo.get("Deal_Name");
        originTown = dealInfo.get("Origin_Town");
        destinationTown = dealInfo.get("Destination_Town");
        originStreet = dealInfo.get("Origin_Street");
        destinationStreet = dealInfo.get("Destination_Street");
        
        // Get Move_Types data from Deal's Service_Type lookup field
        moveTypeData = dealInfo.get("Service_Type");
        moveTypeId = null;
        
        if(moveTypeData != null)
        {
            moveTypeId = moveTypeData.get("id");
        }
        
        quoteMainBody = "";
        quoteBottomBody = "";
        
        if(moveTypeId != null && moveTypeId != "")
        {
            moveTypeInfo = zoho.crm.getRecordById("Move_Types", moveTypeId);
            
            if(moveTypeInfo != null)
            {
                quoteMainBody = moveTypeInfo.get("Quote_Main_Body");
                quoteBottomBody = moveTypeInfo.get("Quote_Bottom_Body");
                
                // Handle null values
                if(quoteMainBody == null)
                {
                    quoteMainBody = "";
                }
                if(quoteBottomBody == null)
                {
                    quoteBottomBody = "";
                }
            }
        }
        
        // Build the HTML quotation preview
        quotationHTML = "<div style='font-family: Arial, sans-serif; padding: 20px;'>";
        
        // Deal Information Table
        quotationHTML = quotationHTML + "<h2 style='color: #2c3e50; margin-bottom: 20px;'>Quotation Details</h2>";
        quotationHTML = quotationHTML + "<table style='width: 100%; border-collapse: collapse; margin-bottom: 30px; border: 1px solid #ddd;'>";
        quotationHTML = quotationHTML + "<tr style='background-color: #f8f9fa;'>";
        quotationHTML = quotationHTML + "<td style='padding: 12px; border: 1px solid #ddd; font-weight: bold; width: 30%;'>Deal Name:</td>";
        quotationHTML = quotationHTML + "<td style='padding: 12px; border: 1px solid #ddd;'>" + ifnull(dealName, "") + "</td>";
        quotationHTML = quotationHTML + "</tr>";
        
        quotationHTML = quotationHTML + "<tr>";
        quotationHTML = quotationHTML + "<td style='padding: 12px; border: 1px solid #ddd; font-weight: bold;'>Origin Location:</td>";
        quotationHTML = quotationHTML + "<td style='padding: 12px; border: 1px solid #ddd;'>" + ifnull(originStreet, "") + ", " + ifnull(originTown, "") + "</td>";
        quotationHTML = quotationHTML + "</tr>";
        
        quotationHTML = quotationHTML + "<tr style='background-color: #f8f9fa;'>";
        quotationHTML = quotationHTML + "<td style='padding: 12px; border: 1px solid #ddd; font-weight: bold;'>Destination Location:</td>";
        quotationHTML = quotationHTML + "<td style='padding: 12px; border: 1px solid #ddd;'>" + ifnull(destinationStreet, "") + ", " + ifnull(destinationTown, "") + "</td>";
        quotationHTML = quotationHTML + "</tr>";
        
        quotationHTML = quotationHTML + "</table>";
        
        // Quote Main Body
        quotationHTML = quotationHTML + "<div style='margin-bottom: 30px;'>";
        quotationHTML = quotationHTML + "<h3 style='color: #2c3e50; margin-bottom: 15px;'>Quote Details</h3>";
        quotationHTML = quotationHTML + "<div style='line-height: 1.6;'>" + quoteMainBody + "</div>";
        quotationHTML = quotationHTML + "</div>";
        
        // Quote Bottom Body
        quotationHTML = quotationHTML + "<div style='margin-top: 30px; padding-top: 20px; border-top: 2px solid #e0e0e0;'>";
        quotationHTML = quotationHTML + "<div style='line-height: 1.6;'>" + quoteBottomBody + "</div>";
        quotationHTML = quotationHTML + "</div>";
        
        quotationHTML = quotationHTML + "</div>";
        
        // Update the Quote record with the generated preview
        updateMap = Map();
        updateMap.put("Quote_Preview", quotationHTML);
        
        updateResp = zoho.crm.updateRecord("Quotes", quoteId, updateMap);
        
        info "Quote preview generated successfully for Quote ID: " + quoteId;
    }
}
