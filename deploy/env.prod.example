# ---------------------------------------------------------------------------
# Zoho MCP server - production VPS configuration (multi-tenant portal).
#
#   cp deploy/env.prod.example .env
#   docker compose -f docker-compose.prod.yml up -d --build
#
# Keep .env at the repository root and mode 600: it holds every master secret.
# ---------------------------------------------------------------------------

# --- Public origin (must match DNS and the TLS certificate) ---------------
SITE_ADDRESS=mcp.example.com
ACME_EMAIL=you@example.com
PORTAL_BASE_URL=https://mcp.example.com

# --- Master key -----------------------------------------------------------
# Encrypts every stored Zoho secret and token with Fernet. BACK IT UP: without
# it, portal.db cannot be decrypted and every user must reconnect.
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
MCP_SECRET_KEY=

# --- Connection portal (multi-tenant) ------------------------------------
# Each user signs in with OIDC, brings their own Zoho client ID/secret, and
# receives a personal MCP API key. Remove this block for a single-tenant
# deployment and set MCP_HTTP_TOKEN instead.
PORTAL_ENABLED=true
PORTAL_DB_PATH=/data/portal.db

# Any OIDC issuer that publishes /.well-known/openid-configuration.
# Google, Microsoft Entra, Okta, Auth0 and Keycloak all work. GitHub is plain
# OAuth2, not OIDC, so it is not supported by the generic client.
PORTAL_OIDC_ISSUER=https://accounts.google.com
PORTAL_OIDC_CLIENT_ID=
PORTAL_OIDC_CLIENT_SECRET=
PORTAL_OIDC_NAME=Google

# --- HTTP transport ------------------------------------------------------
MCP_TRANSPORT=http
MCP_HOST=0.0.0.0
MCP_PORT=8000
# Fail closed: refuse to start unless a credential source (portal or shared
# token) is present. Prevents an accidentally open /mcp endpoint.
MCP_REQUIRE_AUTH=true
# DNS-rebinding protection: the Host/Origin the public requests carry.
MCP_ALLOWED_HOSTS=mcp.example.com
MCP_ALLOWED_ORIGINS=https://mcp.example.com
TOKEN_FILE_PATH=/data/.zoho_tokens.json
LOG_LEVEL=INFO

# --- Optional: one process-wide Zoho connection --------------------------
# Not required in portal mode (every user connects their own account), but if
# set, callers that use the shared MCP_HTTP_TOKEN resolve to this connection.
#ZOHO_CLIENT_ID=
#ZOHO_CLIENT_SECRET=
#ZOHO_REFRESH_TOKEN=
#ZOHO_SCOPE=all

# --- Optional: single-tenant shared key ----------------------------------
# Only when the portal is disabled. Never combine with PORTAL_DEV_LOGIN on a
# public host.
#MCP_HTTP_TOKEN=

# --- Optional: read-only mode --------------------------------------------
# Blocks every write operation (POST/PUT/PATCH/DELETE).
#MCP_READ_ONLY=false
