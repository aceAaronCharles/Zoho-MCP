# Environment for the Zoho MCP systemd service.
# Install to /etc/zoho-mcp/zoho-mcp.env owned by root:zoho-mcp, mode 0640.
#
#   sudo install -o root -g zoho-mcp -m 0640 \
#        deploy/systemd/zoho-mcp.env.example /etc/zoho-mcp/zoho-mcp.env
#
# systemd reads this file; do NOT use `export` or shell expansion here.

# --- Transport ------------------------------------------------------------
MCP_TRANSPORT=http
# Bind loopback and let a reverse proxy (Caddy/nginx) terminate TLS on the host.
MCP_HOST=127.0.0.1
MCP_PORT=8000

# DNS-rebinding protection: the public hostname and origin.
MCP_ALLOWED_HOSTS=zoho.example.com
MCP_ALLOWED_ORIGINS=https://zoho.example.com

# --- Authentication (REQUIRED) -------------------------------------------
# A loopback bind is not a substitute for authentication: if anything (e.g. a
# reverse proxy) can reach this port, /mcp would be open to the world. This
# flag makes the service refuse to start unless a credential source exists.
MCP_REQUIRE_AUTH=true

# Choose ONE:
#   (A) Multi-tenant portal - each user connects their own Zoho account.
PORTAL_ENABLED=true
PORTAL_BASE_URL=https://zoho.example.com
#   (B) Single tenant - one shared Zoho account.
#MCP_HTTP_TOKEN=

# --- Portal (multi-tenant) -----------------------------------------------

# Master key that encrypts every stored Zoho credential. BACK THIS UP: losing
# it makes portal.db undecryptable.
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
MCP_SECRET_KEY=

# OIDC identity provider for portal sign-in.
PORTAL_OIDC_ISSUER=https://accounts.google.com
PORTAL_OIDC_CLIENT_ID=
PORTAL_OIDC_CLIENT_SECRET=
PORTAL_OIDC_NAME=Google

# --- Zoho (single tenant, or the shared process-wide connection) ----------
# Not required in portal-only mode.
#ZOHO_CLIENT_ID=
#ZOHO_CLIENT_SECRET=
#ZOHO_REFRESH_TOKEN=
#ZOHO_SCOPE=all

# --- State and logging ----------------------------------------------------
TOKEN_FILE_PATH=/var/lib/zoho-mcp/.zoho_tokens.json
PORTAL_DB_PATH=/var/lib/zoho-mcp/portal.db
LOG_FILE_PATH=/var/log/zoho-mcp/zoho-mcp.log
LOG_LEVEL=INFO

# --- Backups (zoho-mcp-backup.timer) -------------------------------------
#BACKUP_RETENTION_DAYS=14
