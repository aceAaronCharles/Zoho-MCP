[Unit]
Description=Back up the Zoho MCP portal database and token file
Documentation=https://github.com/aceAaronCharles/Zoho-MCP/blob/main/DEPLOY.md
After=zoho-mcp.service

[Service]
Type=oneshot
User=zoho-mcp
Group=zoho-mcp
EnvironmentFile=/etc/zoho-mcp/zoho-mcp.env
Environment=BACKUP_DIR=/var/backups/zoho-mcp
ExecStart=/opt/zoho-mcp/deploy/backup.sh

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/zoho-mcp /var/backups/zoho-mcp
UMask=0077
