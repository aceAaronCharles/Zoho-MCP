[Unit]
Description=Zoho MCP server
Documentation=https://github.com/aceAaronCharles/Zoho-MCP/blob/main/DEPLOY.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=zoho-mcp
Group=zoho-mcp
WorkingDirectory=/opt/zoho-mcp
EnvironmentFile=/etc/zoho-mcp/zoho-mcp.env
ExecStart=/opt/zoho-mcp/.venv/bin/python -m src.server

Restart=on-failure
RestartSec=5
TimeoutStopSec=20

# --- Filesystem and privilege hardening -----------------------------------
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077

# Everything on the filesystem is read-only except these state/log dirs, which
# systemd creates and grants access to.
StateDirectory=zoho-mcp
LogsDirectory=zoho-mcp
ReadWritePaths=/var/lib/zoho-mcp /var/log/zoho-mcp

# Some wheels (JIT, some crypto builds) need executable memory; if the service
# refuses to start with the line above enabled, uncomment to relax it.
#MemoryDenyWriteExecute=false
# Optional extra confinement; enable if your kernel/systemd accept it.
#SystemCallFilter=@system-service
#SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
