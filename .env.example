# Zoho MCP Server configuration
# Copy this file to .env and fill in the required values.

# ---------------------------------------------------------------------------
# Required for headless use (no browser needed)
# ---------------------------------------------------------------------------
# Create a Server-based Application at https://api-console.zoho.com/ and grant
# it the scopes you need (or "all" via ZOHO_SCOPE below).
ZOHO_CLIENT_ID=your_client_id_here
ZOHO_CLIENT_SECRET=your_client_secret_here

# Generate a refresh token once, then keep it secret. See README "Obtaining a
# refresh token". With this set the server never needs a browser.
ZOHO_REFRESH_TOKEN=your_refresh_token_here

# Optional during the one-time interactive consent flow.
ZOHO_REDIRECT_URI=http://localhost:8080/callback
# Allow the browser consent flow (only needed to create a token file once).
ZOHO_INTERACTIVE_AUTH=false

# Comma-separated OAuth scopes, or a preset:
#   all          - every app in the catalog (default)
#   recommended  - validated core set for the apps with dedicated tools
# Zoho still enforces the scopes actually granted to the refresh token.
# To trim the `all` preset without writing the whole list:
# ZOHO_SCOPE_EXCLUDE=ZohoVault.secrets.ALL,ZohoTeamInbox.channels.ALL
ZOHO_SCOPE=all

# ---------------------------------------------------------------------------
# Data centre (defaults to com). Use the matching domain for your account.
# ---------------------------------------------------------------------------
# ZOHO_DC=com
# ZOHO_API_DOMAIN=https://www.zohoapis.com
# ZOHO_ACCOUNTS_DOMAIN=https://accounts.zoho.com

# Organisation IDs (usually auto-discovered; set them to be explicit)
# ZOHO_DESK_ORG_ID=1234567890
# ZOHO_ANALYTICS_ORG_ID=1234567890

# ---------------------------------------------------------------------------
# Token storage
# ---------------------------------------------------------------------------
TOKEN_FILE_PATH=.zoho_tokens.json

# ---------------------------------------------------------------------------
# Transports: stdio (default, for local MCP clients) or http (for hosting)
# ---------------------------------------------------------------------------
MCP_TRANSPORT=stdio
# MCP_HOST=0.0.0.0
# MCP_PORT=8000
# MCP_HTTP_PATH=/mcp
# Set to true for plain JSON responses instead of SSE (some clients prefer it).
# MCP_HTTP_JSON_RESPONSE=false
# Comma-separated Host / Origin allow-lists for DNS-rebinding protection when
# the MCP transport is exposed directly. Example: example.com,example.com:443
# MCP_ALLOWED_HOSTS=
# MCP_ALLOWED_ORIGINS=

# Shared bearer token for a single-tenant HTTP deployment. Clients must send:
# Authorization: Bearer <token>
# When the connection portal is enabled this is optional; it maps to the
# process-wide connection from the ZOHO_* variables above.
# MCP_HTTP_TOKEN=change-me-to-a-long-random-value

# ---------------------------------------------------------------------------
# Multi-tenant connection portal (optional, recommended for hosting)
# ---------------------------------------------------------------------------
# Serves a setup UI at PORTAL_BASE_URL/portal where each user signs in with
# your identity provider, enters their own Zoho client ID/secret, connects
# their Zoho account, and creates a personal MCP API key.
# PORTAL_ENABLED=false
# PORTAL_BASE_URL=https://zoho.example.com
# Path to the SQLite database (contains encrypted credentials).
# PORTAL_DB_PATH=/data/portal.db
# Must be the same value in MCP_SECRET_KEY below if you prefer one secret.
# PORTAL_SESSION_SECRET=change-me-to-a-long-random-value
# How long a portal sign-in lasts, in seconds (default 7 days).
# PORTAL_SESSION_TTL=604800
# Set true when serving over HTTPS (defaults to true when PORTAL_BASE_URL is https).
# PORTAL_COOKIE_SECURE=true

# Master key used to encrypt Zoho client secrets and tokens at rest. REQUIRED
# when PORTAL_ENABLED=true. Use a long random value and never commit it.
# Generate one with: python -c "import secrets;print(secrets.token_urlsafe(48))"
# MCP_SECRET_KEY=

# OIDC identity provider (Google, Microsoft Entra, Okta, Auth0, Keycloak, ...).
# Register this callback URL with the provider:
#   ${PORTAL_BASE_URL}/portal/auth/callback
# PORTAL_OIDC_ISSUER=https://accounts.google.com
# PORTAL_OIDC_CLIENT_ID=
# PORTAL_OIDC_CLIENT_SECRET=
# PORTAL_OIDC_SCOPES=openid email profile
# PORTAL_OIDC_NAME=Google
# Local-only shortcut: allow signing in by typing an email, no IdP required.
# NEVER enable this on a public deployment.
# PORTAL_DEV_LOGIN=false

# The OAuth callback registered in each user's Zoho API client. Defaults to
# ${PORTAL_BASE_URL}/oauth/zoho/callback.
# ZOHO_OAUTH_REDIRECT_URI=https://zoho.example.com/oauth/zoho/callback

# ---------------------------------------------------------------------------
# Safety and logging
# ---------------------------------------------------------------------------
# Block every write operation (POST/PUT/PATCH/DELETE) when true.
MCP_READ_ONLY=false
MCP_SERVER_NAME=Zoho
MCP_SERVER_VERSION=2.0.0
LOG_LEVEL=INFO
# LOG_FILE_PATH=logs/zoho_mcp.log

# Per-app base URL overrides (rarely needed). Example:
# ZOHO_CRM_BASE_URL=https://www.zohoapis.com
